# copie para .env e preencha

# banco Postgres (Neon, Render, Railway...). local: postgres://usuario:senha@localhost:5432/loja
DATABASE_URL=
# 1 se o banco exigir SSL (Neon/Render exigem)
DATABASE_SSL=1

# endereço público da loja, sem barra no final
BASE_URL=http://localhost:3000
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

LOJA_NOME=Meridiana
LOJA_EMAIL=contato@sualoja.com.br
# só números com DDI, ex: 5511911615555
LOJA_WHATSAPP=
MAX_PARCELAS=8
FRETE_GRATIS_ACIMA=399

# Mercado Pago > Suas integrações > Credenciais (use as de TESTE primeiro)
MP_ACCESS_TOKEN=
# Mercado Pago > Webhooks > assinatura secreta (opcional mas recomendado)
MP_WEBHOOK_SECRET=

# e-mail (Gmail com senha de app, Zoho, Resend SMTP...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Meridiana <contato@sualoja.com.br>"

# conta admin criada pelo npm run seed
ADMIN_EMAIL=
ADMIN_SENHA=
