<%- include('../partials/topo') %>
<div class="wrap">
  <%- include('_nav') %>
  <div class="cartoes">
    <div><b><%= resumo.a_enviar %></b><span>pagos esperando envio</span></div>
    <div><b><%= resumo.aguardando %></b><span>aguardando pagamento (3 dias)</span></div>
    <div><b><%= brl(resumo.mes) %></b><span>vendido este mês</span></div>
    <div><b><%= resumo.pedidos_mes %></b><span>pedidos pagos este mês</span></div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:28px">
    <div>
      <h2 class="titulo-sec" style="text-align:left">Últimos pedidos</h2>
      <div class="rolavel"><table class="tabela">
        <thead><tr><th>#</th><th>Cliente</th><th>Status</th><th>Total</th></tr></thead>
        <tbody>
        <% recentes.forEach(p => { %><tr><td><a href="/admin/pedidos/<%= p.id %>">#<%= p.id %></a></td><td><%= p.nome %></td><td><span class="st <%= p.status %>"><%= STATUS[p.status] %></span></td><td><%= brl(p.total) %></td></tr><% }) %>
        <% if (!recentes.length) { %><tr><td colspan="4">Nenhum pedido ainda.</td></tr><% } %>
        </tbody>
      </table></div>
    </div>
    <div>
      <h2 class="titulo-sec" style="text-align:left">Estoque baixo</h2>
      <div class="rolavel"><table class="tabela">
        <thead><tr><th>Peça</th><th>Tam.</th><th>Estoque</th></tr></thead>
        <tbody>
        <% baixo.forEach(b => { %><tr><td><a href="/admin/produtos/<%= b.id %>"><%= b.nome %></a></td><td><%= b.tamanho %></td><td><%= b.estoque %></td></tr><% }) %>
        <% if (!baixo.length) { %><tr><td colspan="3">Tudo certo.</td></tr><% } %>
        </tbody>
      </table></div>
    </div>
  </div>
</div>
<%- include('../partials/fim') %>
