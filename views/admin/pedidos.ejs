<%- include('../partials/topo') %>
<div class="wrap">
  <%- include('_nav') %>
  <div class="chips" style="justify-content:flex-start;margin-bottom:22px">
    <a class="chip <%= !st ? 'on' : '' %>" href="/admin/pedidos">Todos</a>
    <% Object.keys(STATUS).forEach(k => { %><a class="chip <%= st === k ? 'on' : '' %>" href="/admin/pedidos?status=<%= k %>"><%= STATUS[k] %></a><% }) %>
  </div>
  <div class="rolavel"><table class="tabela">
    <thead><tr><th>#</th><th>Data</th><th>Cliente</th><th>Destino</th><th>Status</th><th>Total</th></tr></thead>
    <tbody>
    <% lista.forEach(p => { %>
      <tr>
        <td><a href="/admin/pedidos/<%= p.id %>">#<%= p.id %></a></td>
        <td><%= new Date(p.criado_em).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) %></td>
        <td><%= p.nome %></td>
        <td><%= p.endereco.cidade %>/<%= p.endereco.uf %></td>
        <td><span class="st <%= p.status %>"><%= STATUS[p.status] %></span></td>
        <td><%= brl(p.total) %></td>
      </tr>
    <% }) %>
    <% if (!lista.length) { %><tr><td colspan="6">Nenhum pedido.</td></tr><% } %>
    </tbody>
  </table></div>
</div>
<%- include('../partials/fim') %>
