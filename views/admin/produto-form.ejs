<%- include('../partials/topo') %>
<div class="wrap">
  <%- include('_nav') %>
  <nav class="trilha" style="padding-top:0"><a href="/admin/produtos">Produtos</a> › <%= p.id ? p.nome : 'Novo' %><% if (p.slug) { %> · <a href="/produto/<%= p.slug %>" target="_blank">ver na loja</a><% } %></nav>
  <% if (erro) { %><div class="erros" role="alert"><%= erro %></div><% } %>

  <form class="caixa" method="post" action="/admin/produtos/salvar" enctype="multipart/form-data" style="max-width:900px">
    <% if (p.id) { %><input type="hidden" name="id" value="<%= p.id %>"><% } %>
    <div class="form-grade">
      <div class="campo g"><label for="nome">Nome</label><input id="nome" name="nome" required value="<%= p.nome || '' %>"></div>
      <div class="campo p"><label for="cat">Categoria</label>
        <select id="cat" name="categoria_id"><option value="">—</option>
          <% categorias.forEach(c => { %><option value="<%= c.id %>" <%= p.categoria_id === c.id ? 'selected' : '' %>><%= c.nome %></option><% }) %>
        </select>
      </div>
      <div class="campo p"><label for="preco">Preço (R$)</label><input id="preco" name="preco" inputmode="decimal" required value="<%= p.preco ? String(Number(p.preco).toFixed(2)).replace('.', ',') : '' %>" placeholder="389,90"></div>
      <div class="campo p"><label for="antigo">Preço antigo (opcional)</label><input id="antigo" name="preco_antigo" inputmode="decimal" value="<%= p.preco_antigo ? String(Number(p.preco_antigo).toFixed(2)).replace('.', ',') : '' %>"><span class="dica">Mostra riscado e o selo de %</span></div>
      <div class="campo p" style="justify-content:flex-end;gap:10px">
        <label><input type="checkbox" name="ativo" <%= p.ativo !== false ? 'checked' : '' %> style="width:auto;min-height:0"> No ar</label>
        <label><input type="checkbox" name="destaque" <%= p.destaque ? 'checked' : '' %> style="width:auto;min-height:0"> Destaque na home</label>
      </div>
      <div class="campo"><label for="tams">Tamanhos e estoque</label><input id="tams" name="tamanhos" required value="<%= p.tamanhosTxt || '' %>"><span class="dica">Formato TAMANHO:QUANTIDADE separado por vírgula. Ex.: PP:2, P:5, M:5, G:3. Para acessório: ÚNICO:10</span></div>
      <div class="campo"><label for="desc">Descrição</label><textarea id="desc" name="descricao" rows="6"><%= p.descricao || '' %></textarea></div>

      <% if (p.imagens && p.imagens.length) { %>
      <div class="campo"><span class="rotulo" style="margin:0">Fotos atuais (marque para remover)</span>
        <div class="thumbs"><% p.imagens.forEach(id => { %><label><img src="/img/<%= id %>" alt=""><span><input type="checkbox" name="remover" value="<%= id %>"> remover</span></label><% }) %></div>
      </div>
      <% } %>
      <div class="campo"><label for="fotos">Adicionar fotos</label><input id="fotos" name="fotos" type="file" accept="image/jpeg,image/png,image/webp" multiple><span class="dica">JPG, PNG ou WebP até 4 MB cada. A primeira é a capa; a segunda aparece quando passa o mouse. Proporção ideal 7:10.</span></div>
    </div>
    <button class="btn" style="margin-top:24px">Salvar produto</button>
  </form>
</div>
<%- include('../partials/fim') %>
