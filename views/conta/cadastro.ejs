<%- include('../partials/topo') %>

<div class="wrap medio">
  <h1 class="pag">Criar conta</h1>
  <% if (erros.length) { %><div class="erros" role="alert"><ul><% erros.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>

  <form class="caixa" method="post" action="/cadastro" novalidate>
    <div class="form-grade">
      <div class="campo">
        <label for="nome">Nome completo</label>
        <input id="nome" name="nome" autocomplete="name" required value="<%= v.nome || '' %>">
      </div>
      <div class="campo m">
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required value="<%= v.email || '' %>">
        <span class="dica">Confirmação de pedido e rastreio chegam aqui</span>
      </div>
      <div class="campo m">
        <label for="senha">Senha</label>
        <input id="senha" name="senha" type="password" autocomplete="new-password" minlength="8" required>
        <span class="dica">Mínimo de 8 caracteres</span>
      </div>
      <div class="campo m">
        <label for="cpf">CPF</label>
        <input id="cpf" name="cpf" inputmode="numeric" required value="<%= v.cpf || '' %>" placeholder="000.000.000-00">
        <span class="dica">Necessário para a nota fiscal e o envio</span>
      </div>
      <div class="campo m">
        <label for="telefone">Celular / WhatsApp</label>
        <input id="telefone" name="telefone" type="tel" inputmode="numeric" autocomplete="tel" required value="<%= v.telefone || '' %>" placeholder="(11) 90000-0000">
      </div>
      <div class="campo" style="margin-top:12px"><span class="rotulo" style="margin:0">Endereço de entrega</span></div>
      <%- include('../partials/endereco', { v }) %>
    </div>
    <button class="btn largo" style="margin-top:28px">Criar conta</button>
    <p style="font-size:14px;text-align:center;margin-bottom:0">Já tem conta? <a href="/entrar">Entrar</a></p>
  </form>
</div>

<%- include('../partials/fim') %>
