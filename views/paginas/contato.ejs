<%- include('../partials/topo') %>
<div class="wrap medio">
  <nav class="trilha"><a href="/">Home</a> › <%= titulo %></nav>
  <h1 class="pag"><%= titulo %></h1>
  <div class="caixa" style="line-height:1.75">
    <p style="margin-top:0">Respondemos em até 1 dia útil. <% if (loja.whatsapp) { %>Pelo WhatsApp é mais rápido: <a href="https://wa.me/<%= loja.whatsapp %>">chamar agora</a>.<% } %></p>
    <form method="post" action="/contato" class="form-grade" style="margin-top:20px">
      <div class="campo m"><label for="c-nome">Nome</label><input id="c-nome" name="nome" required value="<%= cliente ? cliente.nome : '' %>"></div>
      <div class="campo m"><label for="c-email">E-mail</label><input id="c-email" name="email" type="email" required value="<%= cliente ? cliente.email : '' %>"></div>
      <div class="campo"><label for="c-msg">Mensagem</label><textarea id="c-msg" name="mensagem" rows="6" required></textarea></div>
      <div class="campo"><button class="btn" style="align-self:flex-start">Enviar</button></div>
    </form>
  </div>
</div>
<%- include('../partials/fim') %>
