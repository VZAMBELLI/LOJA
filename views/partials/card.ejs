<%
  const imgs = p.imagens || []
  const temEstoque = (p.tamanhos || []).some(t => t.e > 0)
%>
<article class="card">
  <a class="foto" href="/produto/<%= p.slug %>" tabindex="-1" aria-hidden="true">
    <% if (imgs.length) { %>
      <img src="/img/<%= imgs[0] %>" alt="" loading="lazy">
      <% if (imgs[1]) { %><img src="/img/<%= imgs[1] %>" alt="" loading="lazy"><% } %>
    <% } else { %>
      <span class="sem-img">[foto]</span>
    <% } %>
  </a>
  <% if (p.preco_antigo && Number(p.preco_antigo) > Number(p.preco)) { %><span class="selo">-<%= Math.round(100 - p.preco / p.preco_antigo * 100) %>%</span><% } else if (!temEstoque) { %><span class="selo" style="background:#5F5D5A">Esgotado</span><% } %>
  <button class="coracao" type="button" data-id="<%= p.id %>" aria-pressed="<%= !!p.fav %>" aria-label="<%= p.fav ? 'Remover dos favoritos' : 'Adicionar aos favoritos' %>">
    <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#1B1B1B" stroke-width="1.5"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
  </button>
  <h3><a href="/produto/<%= p.slug %>"><%= p.nome %></a></h3>
  <div class="preco">
    <% if (p.preco_antigo && Number(p.preco_antigo) > Number(p.preco)) { %><s><%= brl(p.preco_antigo) %></s><% } %><%= brl(p.preco) %>
  </div>
  <div class="parc">ou <%= loja.parcelas %>x de <%= brl(p.preco / loja.parcelas) %></div>
  <div class="quick">
    <% if (temEstoque) { %>
      <button class="btn js-quick" type="button">Quick Add</button>
      <div class="tams" role="group" aria-label="Tamanhos de <%= p.nome %>">
        <% p.tamanhos.forEach(t => { %>
          <button class="tam" type="button" data-v="<%= t.id %>" <%= t.e > 0 ? '' : 'disabled' %>><%= t.t %></button>
        <% }) %>
      </div>
    <% } else { %>
      <a class="btn vazado" href="/produto/<%= p.slug %>">Ver peça</a>
    <% } %>
  </div>
</article>
