</main>

<footer class="rodape">
  <div class="wrap">
    <div class="cols">
      <div>
        <div style="font-size:22px;letter-spacing:.3em;color:#fff"><%= loja.nome.toUpperCase() %><span style="color:var(--rosa-claro)">.</span></div>
        <p style="max-width:280px;color:#A9A6A2">Moda feminina com envio para todo o Brasil. Parcele em até <%= loja.parcelas %>x sem juros.</p>
      </div>
      <div>
        <h4>Loja</h4>
        <% categorias.slice(0, 6).forEach(c => { %><a href="/c/<%= c.slug %>"><%= c.nome %></a><% }) %>
      </div>
      <div>
        <h4>Ajuda</h4>
        <a href="/p/como-comprar">Como comprar</a>
        <a href="/p/trocas-e-devolucoes">Trocas e devoluções</a>
        <a href="/p/politica-de-envio">Política de envio</a>
        <a href="/p/perguntas-frequentes">Perguntas frequentes</a>
      </div>
      <div>
        <h4>Atendimento</h4>
        <a href="/p/contato">Contato</a>
        <a href="/p/quem-somos">Quem somos</a>
        <a href="/p/privacidade">Privacidade</a>
        <a href="/conta/pedidos">Meus pedidos</a>
      </div>
    </div>
    <div class="base">
      <span>© <%= new Date().getFullYear() %> <%= loja.nome %> · [CNPJ] · [CIDADE/UF]</span>
      <span>Cartão em até <%= loja.parcelas %>x · Pix · Boleto — pagamento via Mercado Pago</span>
    </div>
  </div>
</footer>

<div class="cookies" hidden>
  <span>Ao navegar por este site você aceita o uso de cookies para agilizar a sua experiência de compra.</span>
  <button class="btn vazado" type="button">Entendi</button>
</div>

<% if (loja.whatsapp) { %>
<a class="zap" href="https://wa.me/<%= loja.whatsapp %>" target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
  <svg aria-hidden="true" width="30" height="30" viewBox="0 0 32 32" fill="#fff"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.6c-2 0-4-.5-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.6 3.6 0 0 0-1.1 2.7 6.3 6.3 0 0 0 1.3 3.3 14.4 14.4 0 0 0 5.5 4.9c2 .9 2.8.9 3.8.8.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.3.2-1.5l-.5-.3z"/></svg>
</a>
<% } %>


<script src="/static/js/loja.js"></script>
</body>
</html>
