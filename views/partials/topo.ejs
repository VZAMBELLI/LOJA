<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titulo ? titulo + ' · ' + loja.nome : loja.nome + ' · moda feminina' %></title>
<meta name="description" content="<%= loja.nome %> — vestidos, conjuntos, alfaiataria e acessórios. Envio para todo o Brasil.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/loja.css">
</head>
<body>
<a class="so-leitor" href="#conteudo">Pular para o conteúdo</a>

<div class="faixa">Use o cupom <b>BEMVINDA</b> e ganhe 5% na primeira compra</div>

<div class="wrap util">
  <span>
    <% if (loja.whatsapp) { %><a href="https://wa.me/<%= loja.whatsapp %>"><%= loja.whatsapp.replace(/^55(\d{2})(\d{4,5})(\d{4})$/, '($1) $2-$3') %></a><span class="sep">|</span><% } %>
    <% if (loja.email) { %><a href="mailto:<%= loja.email %>"><%= loja.email %></a><% } %>
  </span>
  <span>
    <% if (cliente) { %>
      <a href="/conta">Olá, <%= cliente.nome.split(' ')[0] %></a><span class="sep">|</span>
      <% if (cliente.is_admin) { %><a href="/admin">Painel</a><span class="sep">|</span><% } %>
      <form method="post" action="/sair" style="display:inline"><button class="link" style="text-decoration:none">Sair</button></form>
    <% } else { %>
      <a href="/cadastro">Cadastre-se</a><span class="sep">|</span><a href="/entrar">Login</a>
    <% } %>
  </span>
</div>

<header class="wrap topo">
  <a class="logo" href="/" aria-label="<%= loja.nome %> — início">
    <span><%= loja.nome.toUpperCase() %><i>.</i></span>
    <small>STORE</small>
  </a>
  <nav class="menu" aria-label="Principal">
    <a href="/" class="<%= caminho === '/' ? 'on' : '' %>">Início</a>
    <a href="/produtos" class="<%= caminho.startsWith('/produto') || caminho.startsWith('/c/') ? 'on' : '' %>">Produtos</a>
    <a href="/p/como-comprar">Como comprar</a>
    <a href="/p/trocas-e-devolucoes">Trocas e devoluções</a>
    <a href="/p/politica-de-envio">Política de envio</a>
    <a href="/p/perguntas-frequentes">Perguntas frequentes</a>
    <a href="/p/contato">Contato</a>
    <a href="/p/quem-somos">Quem somos</a>
  </nav>
  <div class="acoes">
    <form class="busca" action="/produtos" role="search">
      <label for="q" class="so-leitor">Buscar</label>
      <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#5F5D5A" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <input id="q" name="q" type="search" placeholder="Buscar">
    </form>
    <a class="icone" href="/conta/favoritos" aria-label="Favoritos">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
    </a>
    <a class="icone" href="/sacola" aria-label="Sacola">
      <svg aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
      <span class="n js-qtd-sacola" <%= qtdSacola ? '' : 'hidden' %>><%= qtdSacola %></span>
    </a>
    <button class="burger" aria-label="Menu" aria-expanded="false">
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>

<% if (aviso) { %><div class="aviso <%= aviso.tipo === 'erro' ? 'erro' : '' %>" role="status"><%= aviso.txt %></div><% } %>
<main id="conteudo">
